# Atlas — local development environment.
#
# Copy this file to .env (gitignored) and fill in real values:
#
#   cp .env.example .env
#
# `make server` / `make dev` / `make env-check` load .env automatically —
# see the Makefile. Every key here is an existing ATLAS_* variable read by
# internal/platform/config; nothing here is a separate configuration system.

ATLAS_ENVIRONMENT=development

# Local Postgres — matches docker-compose.yml / `make db-up`. This password
# is the fixed local-dev-only credential already used by the Makefile's own
# `run`/`migrate` targets; it is not a production secret.
ATLAS_DATABASE_HOST=127.0.0.1
ATLAS_DATABASE_PORT=5432
ATLAS_DATABASE_NAME=atlas
ATLAS_DATABASE_USER=atlas
ATLAS_DATABASE_PASSWORD=atlas_dev_password
ATLAS_DATABASE_SSL_MODE=disable
ATLAS_DATABASE_MIGRATE_ON_START=true

# Fleet: the agent-facing listener, plus its libp2p transport (ADR-0012) for
# reaching an Agent that only has an Atlas Relay to dial out through.
ATLAS_FLEET_ENABLED=true
ATLAS_FLEET_DATA_DIR=/tmp/atlas-server-poc/fleet
ATLAS_FLEET_LIBP2P_ENABLED=true
ATLAS_FLEET_LIBP2P_LISTEN_ADDRS=/ip4/0.0.0.0/tcp/4102
# Placeholder — replace with your Atlas Relay's real multiaddr (host, port,
# and its Peer ID). Not committed with a real address on purpose: this file
# is tracked, and a relay address names a real reachable host.
ATLAS_FLEET_LIBP2P_RELAY_ADDR=/ip4/203.0.113.10/tcp/4103/p2p/12D3KooWPlaceholderRelayPeerID00000000000000000000

# ---------------------------------------------------------------------------
# Reference only: the Linux server's Atlas Relay and Atlas Agent read their
# own ATLAS_RELAY_* / ATLAS_AGENT_* variables (see internal/relay/config.go,
# internal/agent/config.go). They run under systemd on that machine, not from
# this Makefile — listed here only so the full picture is in one file.
#
# ATLAS_RELAY_DATA_DIR=/var/lib/atlas-relay
# ATLAS_RELAY_LISTEN_ADDRS=/ip4/0.0.0.0/tcp/4103
# ATLAS_AGENT_CONTROL_PLANE_URL=https://<mac-address>:8443
# ATLAS_AGENT_TOKEN=<enrollment token — never commit a real one>
# ATLAS_AGENT_TRANSPORT=libp2p
# ATLAS_AGENT_LIBP2P_RELAY_ADDR=<same relay multiaddr as above>
# ATLAS_AGENT_LIBP2P_SERVER_PEER_ID=<this Mac's control-plane Peer ID>
