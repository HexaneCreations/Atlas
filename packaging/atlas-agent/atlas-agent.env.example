# /etc/atlas-agent/atlas-agent.env
#
# Loaded by systemd (EnvironmentFile=) before atlas-agent starts. install.sh
# writes this file once and never overwrites it on a re-run; edit it directly
# for anything after first install, then `systemctl restart atlas-agent`.
#
# See `atlas-agent --help` for the complete list of ATLAS_AGENT_* variables.

# Required.
ATLAS_AGENT_CONTROL_PLANE_URL=https://control-plane.example.internal:8443

# Required only until a certificate is persisted under
# ATLAS_AGENT_DATA_DIR — one enrollment consumes it, and every start after
# that ignores this value. Safe to blank out (or delete the line) once
# /var/lib/atlas-agent/agent-cert.pem exists.
ATLAS_AGENT_TOKEN=

# Recommended: point at the CA bundle distributed out of band instead of
# trusting the control plane's certificate on first contact (TOFU). See
# docs/architecture/agent-design.md sec 4.
#ATLAS_AGENT_CA_BUNDLE=/etc/atlas-agent/ca-bundle.pem

ATLAS_AGENT_ENVIRONMENT=production

#ATLAS_AGENT_NODE_ID=
#ATLAS_AGENT_COLLECTION_INTERVAL=15s
#ATLAS_AGENT_COLLECTION_TIMEOUT=10s
#ATLAS_AGENT_INVENTORY_INTERVAL=60s
#ATLAS_AGENT_LOG_LEVEL=info
