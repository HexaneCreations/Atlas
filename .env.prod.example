# Atlas — production Compose environment.
#
# Copy to .env.prod (gitignored) and fill in real values, then:
#
#   cp .env.prod.example .env.prod
#   mkdir -p secrets && echo -n 'your-real-password' > secrets/atlas_db_password.txt
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# Every ATLAS_* key here is read by internal/platform/config, the same as
# .env.example for development — this file exists separately so production
# values (verify-full SSL, an external database host, Fleet/libp2p enabled)
# never get confused with the local dev ones.
#
# The database password is NOT here — see docker-compose.prod.yml's
# `secrets:` block and secrets/atlas_db_password.txt below. Never put it in
# this file.

ATLAS_ENVIRONMENT=production

# --------------------------------------------------------- image tags ----
# Unset, docker-compose.prod.yml builds locally from ./Dockerfile and
# ./web/Dockerfile instead — no registry required for a local production
# test. CI/CD sets these to real registry references once one is chosen
# (see the report: no registry is established in this repository yet).
# ATLAS_SERVER_IMAGE=
# ATLAS_UI_IMAGE=
# ATLAS_VERSION=

# Public port for atlas-ui. Put an authenticating reverse proxy in front of
# this — docs/operations/deployment.md is explicit that one is mandatory
# until Atlas ships its own authentication.
ATLAS_UI_PORT=80

# ------------------------------------------------------------ database ---
# PostgreSQL is external/managed — this Compose file does not provision it
# (see docker-compose.prod.yml's header comment). Point this at your real
# instance; TimescaleDB is a hard requirement (migration 0001).
ATLAS_DATABASE_HOST=postgres.internal
ATLAS_DATABASE_PORT=5432
ATLAS_DATABASE_NAME=atlas
ATLAS_DATABASE_USER=atlas
# verify-full, not disable: this is production, per deployment.md.
ATLAS_DATABASE_SSL_MODE=verify-full
ATLAS_DATABASE_MIGRATE_ON_START=true

# ---------------------------------------------------------------- fleet ---
# This deployment IS the Fleet control plane (the working Mac→Relay→Agent
# setup this replaces already runs with this exact shape). Persisted across
# container recreation by the atlas-fleet-data volume in
# docker-compose.prod.yml, mounted at exactly this path — do not change one
# without the other.
ATLAS_FLEET_ENABLED=true
ATLAS_FLEET_DATA_DIR=/var/lib/atlas/fleet
ATLAS_FLEET_LIBP2P_ENABLED=true
# Only needs to be reachable *inside* the container — nothing publishes this
# port (see docker-compose.prod.yml's atlas-server comment on why). Change
# only if 4102 is already in use for some other reason.
ATLAS_FLEET_LIBP2P_LISTEN_ADDRS=/ip4/0.0.0.0/tcp/4102
# Your Atlas Relay's real multiaddr (host, port, and its Peer ID) — the
# control plane dials out to it, exactly like the working Mac setup does.
# Not a real address here on purpose; this file is tracked.
ATLAS_FLEET_LIBP2P_RELAY_ADDR=/ip4/203.0.113.10/tcp/4103/p2p/12D3KooWPlaceholderRelayPeerID00000000000000000000
